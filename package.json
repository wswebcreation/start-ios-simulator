{
  "name": "start-ios-simulator",
  "version": "2.0.0",
  "description": "Start an iOS simulator from your terminal, and set up the iOS runtime and simulators when they are missing",
  "bin": {
    "start-ios-simulator": "dist/cli.js"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "node --experimental-test-module-mocks --test \"test/**/*.test.ts\"",
    "prepublishOnly": "npm run build",
    "test:watch": "node --experimental-test-module-mocks --test --watch \"test/**/*.test.ts\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wswebcreation/start-ios-simulator.git"
  },
  "keywords": [
    "iOS",
    "cli",
    "simulator",
    "xcode",
    "simctl",
    "appium"
  ],
  "author": "wswebcreation",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/wswebcreation/start-ios-simulator/issues"
  },
  "homepage": "https://github.com/wswebcreation/start-ios-simulator#readme",
  "dependencies": {
    "@inquirer/prompts": "^8.7.3"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
